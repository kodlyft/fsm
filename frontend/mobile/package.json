{
  "name": "@kodlyft/mobile",
  "version": "0.1.0",
  "description": "KodLyft FSM technician app (Ionic + Vue + Capacitor + Tailwind v4).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "sync": "cap sync",
    "android:dev": "yarn build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "yarn build && cap sync android && cd android && ./gradlew assembleRelease",
    "ios:dev": "yarn build && cap sync ios && cap open ios",
    "ios:release": "yarn build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@ionic/vue": "^8.8.11",
    "@ionic/vue-router": "^8.8.11",
    "@kodlyft/api": "0.1.0",
    "@kodlyft/design": "0.1.0",
    "@kodlyft/ui": "0.1.0",
    "ionicons": "^8.0.13",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.1",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.15",
    "@vitejs/plugin-vue": "^6.0.7",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.4"
  }
}
