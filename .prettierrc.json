{
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 100,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"bracketSpacing": true,
	"arrowParens": "always",
	"endOfLine": "lf",
	"vueIndentScriptAndStyle": false,
	"overrides": [
		{
			"files": ["*.yml", "*.yaml", "*.md", "*.json"],
			"options": { "useTabs": false, "tabWidth": 2 }
		}
	]
}
