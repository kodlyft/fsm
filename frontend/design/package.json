{
  "name": "@kodlyft/design",
  "version": "0.1.0",
  "description": "KodLyft FSM design tokens — single source of truth for color, type, spacing, radius and elevation.",
  "private": true,
  "type": "module",
  "main": "./src/tokens.ts",
  "types": "./src/tokens.ts",
  "exports": {
    ".": "./src/tokens.ts",
    "./tokens.json": "./tokens.json",
    "./css/*": "./css/*"
  },
  "files": [
    "css",
    "src",
    "tokens.json",
    "build-tokens.mjs"
  ],
  "scripts": {
    "build": "node build-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build-tokens.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
