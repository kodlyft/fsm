{
  "$description": "KodLyft FSM design tokens — single source of truth. Consumed by the Vue console, Vue portal, and Ionic mobile app. `yarn tokens` (build-tokens.mjs) generates CSS variables, the Ionic theme, a Tailwind v4 theme, and a TS export from this file. References use {group.key} and resolve to the referenced value.",
  "color": {
    "brand": {
      "50": { "value": "#E1F5EE" },
      "100": { "value": "#9FE1CB" },
      "300": { "value": "#1D9E75", "$comment": "primary accent" },
      "500": { "value": "#0F6E56" },
      "700": { "value": "#085041" },
      "900": { "value": "#04342C" }
    },
    "neutral": {
      "0": { "value": "#FFFFFF" },
      "50": { "value": "#F7F6F2" },
      "100": { "value": "#F1EFE8" },
      "200": { "value": "#D3D1C7" },
      "400": { "value": "#888780" },
      "600": { "value": "#5F5E5A" },
      "800": { "value": "#2C2C2A" },
      "900": { "value": "#1A1A19" }
    },
    "status": {
      "success": { "value": "#1D9E75", "$comment": "done / paid" },
      "warning": { "value": "#BA7517", "$comment": "scheduled / pending" },
      "danger": { "value": "#A32D2D", "$comment": "overdue / failed" },
      "info": { "value": "#185FA5", "$comment": "informational" }
    }
  },
  "semantic": {
    "$comment": "Mode-aware surface + accent roles. Light maps onto the neutral/brand ramps; dark lifts surfaces and the accent for contrast (design spec §2.3).",
    "light": {
      "bg": { "value": "{color.neutral.0}" },
      "bg-subtle": { "value": "{color.neutral.50}" },
      "surface": { "value": "{color.neutral.100}" },
      "border": { "value": "{color.neutral.200}" },
      "text": { "value": "{color.neutral.900}" },
      "text-muted": { "value": "{color.neutral.600}" },
      "brand": { "value": "{color.brand.300}" }
    },
    "dark": {
      "bg": { "value": "#1A1A19" },
      "bg-subtle": { "value": "#222220" },
      "surface": { "value": "#2C2C2A" },
      "border": { "value": "#44443F" },
      "text": { "value": "#F1EFE8" },
      "text-muted": { "value": "#B4B2A9" },
      "brand": { "value": "#5DCAA5", "$comment": "lift accent for contrast on dark" }
    },
    "command": {
      "$comment": "Dark glassmorphic 'command center' theme for the dispatch console + mobile field app (design ref: glassmorphism + dimensional layering). Always-dark by design — a depth-rich ops surface. The `.kl-command` wrapper remaps the semantic roles above to these values so every component inherits the look.",
      "bg": { "value": "#0B1220", "$comment": "deep base" },
      "bg-2": { "value": "#070C16", "$comment": "darker base for the radial gradient floor" },
      "glow": { "value": "rgba(34,201,160,0.16)", "$comment": "brand aurora glow behind content" },
      "glass": { "value": "rgba(255,255,255,0.055)", "$comment": "card surface" },
      "glass-strong": {
        "value": "rgba(255,255,255,0.085)",
        "$comment": "elevated / hover surface"
      },
      "glass-border": { "value": "rgba(255,255,255,0.10)" },
      "glass-border-strong": { "value": "rgba(255,255,255,0.18)" },
      "text": { "value": "#EEF2F8" },
      "text-muted": { "value": "#93A0B4" },
      "brand": { "value": "#34D6AA", "$comment": "lifted accent for contrast on the dark glass" },
      "blur": { "value": "18px" }
    }
  },
  "gradient": {
    "$comment": "Brand gradients for primary actions, accent chips, and gradient text. Raw stops live only here.",
    "brand": { "value": "linear-gradient(135deg, #34D6AA 0%, #1D9E75 52%, #0F6E56 100%)" },
    "brand-soft": {
      "value": "linear-gradient(135deg, rgba(52,214,170,0.18) 0%, rgba(15,110,86,0.06) 100%)"
    },
    "surface": {
      "value": "linear-gradient(160deg, rgba(255,255,255,0.09) 0%, rgba(255,255,255,0.015) 100%)"
    }
  },
  "font": {
    "family": {
      "ui": {
        "value": "'Plus Jakarta Sans', system-ui, sans-serif",
        "$comment": "distinctive but highly legible"
      },
      "mono": {
        "value": "'JetBrains Mono', monospace",
        "$comment": "tabular figures for money/schedules"
      }
    },
    "size": {
      "xs": { "value": "12px" },
      "sm": { "value": "14px" },
      "base": { "value": "16px" },
      "lg": { "value": "18px" },
      "xl": { "value": "22px" },
      "2xl": { "value": "28px" },
      "3xl": { "value": "34px" }
    },
    "weight": {
      "regular": { "value": "400" },
      "medium": { "value": "500" },
      "bold": { "value": "600" }
    },
    "lineHeight": {
      "tight": { "value": "1.25" },
      "normal": { "value": "1.5" },
      "relaxed": { "value": "1.7" }
    }
  },
  "space": {
    "$comment": "4px base scale",
    "1": { "value": "4px" },
    "2": { "value": "8px" },
    "3": { "value": "12px" },
    "4": { "value": "16px" },
    "5": { "value": "20px" },
    "6": { "value": "24px" },
    "8": { "value": "32px" },
    "12": { "value": "48px" }
  },
  "radius": {
    "sm": { "value": "6px" },
    "md": { "value": "10px" },
    "lg": { "value": "14px" },
    "full": { "value": "999px" }
  },
  "elevation": {
    "$comment": "Functional shadows for light mode + a dimensional 4-level depth scale for the command (glass) theme.",
    "card": { "value": "0 1px 2px rgba(26,26,25,0.06), 0 1px 1px rgba(26,26,25,0.04)" },
    "card-dark": { "value": "0 1px 2px rgba(0,0,0,0.4)" },
    "sheet": { "value": "0 -2px 16px rgba(26,26,25,0.10)" },
    "focus": { "value": "0 0 0 3px rgba(52,214,170,0.40)" },
    "e1": { "value": "0 1px 2px rgba(2,6,16,0.40)" },
    "e2": { "value": "0 6px 16px -8px rgba(2,6,16,0.55)" },
    "e3": { "value": "0 18px 40px -16px rgba(2,6,16,0.65)" },
    "e4": { "value": "0 34px 70px -24px rgba(2,6,16,0.75)" },
    "glass": {
      "value": "0 18px 40px -16px rgba(2,6,16,0.65), inset 0 1px 0 rgba(255,255,255,0.06)"
    },
    "glass-lg": {
      "value": "0 34px 70px -24px rgba(2,6,16,0.75), inset 0 1px 0 rgba(255,255,255,0.08)"
    }
  },
  "touchTarget": {
    "min": { "value": "44px", "$comment": "minimum tap target on mobile" }
  }
}
