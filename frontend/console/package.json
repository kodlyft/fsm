{
  "name": "@kodlyft/console",
  "version": "0.1.0",
  "description": "KodLyft FSM back-office console (Vue 3 + Tailwind v4).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/assets/fsm/fsm-console/ && yarn copy-html-entry",
    "copy-html-entry": "cp ../../fsm/public/fsm-console/index.html ../../fsm/www/fsm-console.html",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kodlyft/api": "0.1.0",
    "@kodlyft/design": "0.1.0",
    "@kodlyft/ui": "0.1.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.4"
  }
}
